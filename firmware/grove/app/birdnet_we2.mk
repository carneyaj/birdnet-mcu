# The Western US field profile. Keep the capture settings in sync with CM55S.
override SCENARIO_APP_SUPPORT_LIST := $(APP_TYPE)
override USE_APP_MAIN_MK := y
FIELD_DIAGNOSTICS ?= 0

APPL_DEFINES += -DBIRDNET_WE2 -DIP_INST_SB_GPIO -DIP_scu -DIP_xdma -DCTRL_POWER_OFF=7
APPL_DEFINES += -DBIRDNET_COMPACT_FRONTEND=1
APPL_DEFINES += -DBIRDNET_ENABLE_PREDICTION_LOGS=$(FIELD_DIAGNOSTICS)
APPL_DEFINES += -DBIRDNET_SKIP_ARENA_ZERO=1
APPL_DEFINES += -DBIRDNET_SKIP_PCM_ZERO=1
APPL_DEFINES += -DBIRDNET_SD_AUDIO_BUFFER_BYTES=4096
APPL_DEFINES += -DBIRDNET_VERIFY_OPUS_ON_WAKE=0
APPL_DEFINES += -DBIRDNET_ENABLE_SERIAL_FILES=1
APPL_DEFINES += -DBIRDNET_OLED_HEIGHT=64
APPL_DEFINES += -DBIRDNET_ENABLE_MAX17048=1
APPL_DEFINES += -DBIRDNET_ENABLE_STATUS_BUTTON=1
APPL_DEFINES += -DBIRDNET_ENABLE_FIELD_MONITORING=1
APPL_DEFINES += -DBIRDNET_BATTERY_PAUSE_MV=3500
APPL_DEFINES += -DBIRDNET_BATTERY_RESUME_MV=3800
APPL_DEFINES += -DBIRDNET_ENABLE_CONSOLE_UART=1
APPL_DEFINES += -DBIRDNET_ENABLE_STATUS_LOGS=$(FIELD_DIAGNOSTICS)
APPL_DEFINES += -DBIRDNET_SAMPLE_RATE_HZ=48000
APPL_DEFINES += -DBIRDNET_USE_AUDIO_ONLY_PREROLLING=1
APPL_DEFINES += -DBIRDNET_GATE_XIP_BETWEEN_WINDOWS=0
APPL_DEFINES += -DBIRDNET_RESTORE_HSC_AFTER_PMU=0
APPL_DEFINES += -DBIRDNET_PMU_FAST_WAKE_CLOCK=1
APPL_DEFINES += -DBIRDNET_INFERENCE_INTERVAL_MS=3000
APPL_DEFINES += -DBIRDNET_INFERENCE_STEP_SAMPLES=0
APPL_DEFINES += -DBIRDNET_STREAMING_CACHE_FRAMES=233
APPL_DEFINES += -DBIRDNET_FRONTEND_STREAMING=0
APPL_DEFINES += -DBIRDNET_ENABLE_SD_DETECTION_LOGGING=1
APPL_DEFINES += -DBIRDNET_ENABLE_DETECTION_AUDIO=1
APPL_DEFINES += -DBIRDNET_DETECTION_AUDIO_CODEC=2
APPL_DEFINES += -DBIRDNET_DETECTION_AUDIO_RICE_QUANT_STEP=80
APPL_DEFINES += -DBIRDNET_SD_LOG_THRESHOLD_Q1E4=2500
APPL_DEFINES += -DBIRDNET_SD_LOG_BUFFER_RECORDS=960
APPL_DEFINES += -DBIRDNET_SD_LOG_FLUSH_INTERVAL_MS=60000
APPL_DEFINES += -DBIRDNET_ENABLE_DETECTION_LED=1
APPL_DEFINES += -DBIRDNET_DETECTION_LED_ACTIVE_LOW=0
APPL_DEFINES += -DBIRDNET_PMU_IDLE_LSC_DIV=1
APPL_DEFINES += -DBIRDNET_PMU_CLOCK_CTRL_BYAPP=0
APPL_DEFINES += -DBIRDNET_PMU_HSC_SRAM_RETENTION_MASK=1
APPL_DEFINES += -DBIRDNET_FRONTEND_BRANCH2_BACKEND=1
APPL_DEFINES += -DBIRDNET_FRONTEND_BRANCH1_DECIMATE2=1
APPL_DEFINES += -DBIRDNET_FRONTEND_BRANCH2_RFFT_USE_C_OVERRIDE=0
APPL_DEFINES += -DBIRDNET_FRONTEND_CMSIS_RFFT_USE_MVE_STAGE=1
APPL_DEFINES += -DBIRDNET_FRONTEND_MEL_USE_MVE_DOT=1
APPL_DEFINES += -DBIRDNET_FRONTEND_FRAME_FILL_USE_MVE=1
APPL_DEFINES += -DBIRDNET_FRONTEND_MINMAX_USE_MVE=1
APPL_DEFINES += -DBIRDNET_FRONTEND_RFFT_DIRECT_MEL=1
APPL_DEFINES += -DBIRDNET_FRONTEND_PARTIAL_REAL=1
APPL_DEFINES += -DBIRDNET_FIELD_MEL_CODES=1
APPL_DEFINES += -DBIRDNET_SKIP_IMMUTABLE_CACHE_WALK=1
APPL_DEFINES += -DBIRDNET_FRONTEND_FOLDED_REORDER=1
APPL_DEFINES += -DBIRDNET_NPU_GATE_DURING_FRONTEND=1
APPL_DEFINES += -DBIRDNET_NPU_AXI_MODEL_MAX_BEATS=1
APPL_DEFINES += -DBIRDNET_FRONTEND_CMSIS_CFFT_VECTOR_TAIL=1
APPL_DEFINES += -DBIRDNET_DUAL_CORE_FIXED_CADENCE=1
APPL_DEFINES += -DBIRDNET_HUMAN_VOCAL_THRESHOLD_Q1E4=3000

LIB_SEL = pwrmgmt sensordp spi_ptl spi_eeprom hxevent hxmb cmsis_dsp tflmtag2209_u55tag2205
MID_SEL = fatfs
FATFS_PORT_LIST = mmc_spi
CMSIS_DRIVERS_LIST += SPI

override OS_SEL :=
override TRUSTZONE := y
override TRUSTZONE_TYPE := security
override TRUSTZONE_FW_TYPE := 1
override CIS_SEL := HM_COMMON
override EPII_USECASE_SEL := drv_dualcore_cm55m_s_only_audonlypmu
override USE_SPECS :=
override LINKER_SCRIPT_FILE := $(SCENARIO_APP_ROOT)/$(APP_TYPE)/birdnet_we2.ld

BIRDNET_APP := $(SCENARIO_APP_ROOT)/$(APP_TYPE)
APPL_APP_INCDIRS += $(BIRDNET_APP)/opus/include
APPL_APP_INCDIRS += ./library/inference/tflmtag2209_u55tag2205
APPL_APP_INCDIRS += ./library/inference/tflmtag2209_u55tag2205/third_party/ethos_u_core_driver/include
override LD_SYSTEMLIBS := -Wl,--wrap=malloc -Wl,--wrap=free -Wl,--wrap=fprintf -Wl,--wrap=fiprintf
override LD_SYSTEMLIBS += -Wl,--wrap=ethosu_invoke_v3 -lm -lc -lgcc -lstdc++ $(BIRDNET_APP)/opus/libopus.a
