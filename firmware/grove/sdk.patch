+/* BIRDNET_BOUNDED_SPI_V1: fail closed until the next disk initialization. */
+static int birdnet_spi_fault;
+
+static uint64_t birdnet_spi_ticks(void)
+{
+    uint32_t value, loops;
+    SystemGetTick(&value, &loops);
+    return (uint64_t)loops * 0x1000000ull + 0x1000000u - value;
+}
+
+static int wait_spi_completed(uint32_t data_count)
+{
+    const uint64_t start = birdnet_spi_ticks();
+    uint32_t budget = SystemCoreClock; /* Fallback if the tick stops advancing. */
+    while (!birdnet_spi_fault &&
+           (Driver_SPI0.GetStatus().busy || Driver_SPI0.GetDataCount() < data_count)) {
+        if (--budget == 0 || birdnet_spi_ticks() - start >= SystemCoreClock / 4u) {
+            birdnet_spi_fault = 1;
+            Driver_SPI0.Control(ARM_SPI_ABORT_TRANSFER, 0);
+        }
+    }
+    return !birdnet_spi_fault;
 }
 
